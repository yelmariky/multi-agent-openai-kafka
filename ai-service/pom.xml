<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.multiagent</groupId>
    <artifactId>ai-service</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>ai-service</name>

    <!-- Java requirements -->
    <properties>
        <java.version>21</java.version>
        <spring.boot.version>3.3.4</spring.boot.version>
    </properties>

    <!-- Import Spring Boot BOM -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
   <repositories>
    <repository>
        <id>openai-maven</id>
        <url>https://maven.openai.com/releases</url>
    </repository>
</repositories>
    <!-- Dependencies -->
    <dependencies>

        <!-- Web server (REST API for the gateway) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Security + JWT validation (Keycloak resource server) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- OpenAI Official Java SDK (GPT-5, Responses API, Embeddings v3) -->
        <!-- OpenAI SDK -->
<dependency>
  <groupId>com.openai</groupId>
  <artifactId>openai-java</artifactId>
  <version>4.8.0</version>
</dependency>



<!-- Resilience4j -->
<dependency>
  <groupId>io.github.resilience4j</groupId>
  <artifactId>resilience4j-spring-boot3</artifactId>
  <version>2.3.0</version>
</dependency>

<!-- Micrometer -->
<dependency>
  <groupId>io.micrometer</groupId>
  <artifactId>micrometer-core</artifactId>
</dependency>

        <!-- For streaming SSE -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Email (CRA reminders, notifications SMTP) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Excel (Apache POI) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- PDF generation -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>2.0.30</version>
        </dependency>

        <!-- PostgreSQL + JPA + pgvector (replaces Weaviate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.pgvector</groupId>
            <artifactId>pgvector</artifactId>
            <version>0.1.6</version>
        </dependency>

        <!-- Cache (used in LLMGatewayService @Cacheable cache) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <version>3.0.2</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <version>8.0.1.Final</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.el</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- Token counting (jtokkit) -->
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- Actuator + Prometheus metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- For internal WebClient usage (ex: IntentAgent calling Gateway) -->
        <!-- JSON (optional but useful for logs / parsing) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

       <dependency>
    <groupId>org.projectlombok</groupId>
    <artifactId>lombok</artifactId>
    <version>1.18.30</version> <!-- ou la dernière version -->
    <scope>provided</scope>
</dependency>


        <!-- Keycloak Admin Client — provisioning realms/users pour multi-tenant -->
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-admin-client</artifactId>
            <version>24.0.2</version>
        </dependency>

        <!-- Kafka — publication d'événements domaine (best-effort, broker optionnel en dev) -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- Build -->
    <build>
        <plugins>

            <!-- Spring Boot plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Java compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <encoding>UTF-8</encoding>
                    <compilerArgs><arg>-parameters</arg></compilerArgs>
                </configuration>
            </plugin>

            <!-- JaCoCo — couverture 80% sur le code testable unitairement -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <configuration>
                    <!-- Exclure les classes qui nécessitent intégration DB/LLM/Keycloak/PDF -->
                    <excludes>
                        <!-- Config Spring et infra -->
                        <exclude>**/config/**</exclude>
                        <exclude>**/infrastructure/**</exclude>
                        <!-- Entités JPA et modèles générés -->
                        <exclude>**/*Entity*</exclude>
                        <exclude>**/AiCoreApplication*</exclude>
                        <!-- Services nécessitant Weaviate / LLM / Keycloak (tests intégration) -->
                        <exclude>**/WeaviateService*</exclude>
                        <exclude>**/RAGService*</exclude>
                        <exclude>**/LLMAIClient*</exclude>
                        <exclude>**/KeycloakProvisioningService*</exclude>
                        <exclude>**/OcrExtractionService*</exclude>
                        <exclude>**/VisionExtractionService*</exclude>
                        <exclude>**/ReceiptUploadService*</exclude>
                        <exclude>**/SemanticSearchService*</exclude>
                        <exclude>**/RerankService*</exclude>
                        <exclude>**/ScopeGuardService*</exclude>
                        <exclude>**/DeleteExpenseService*</exclude>
                        <exclude>**/ExpenseReportService*</exclude>
                        <exclude>**/ReasoningService*</exclude>
                        <!-- PDF / Excel — librairies lourdes, tests intégration -->
                        <exclude>**/CraPdfService*</exclude>
                        <exclude>**/ExpensePdfService*</exclude>
                        <exclude>**/ExpenseExcelService*</exclude>
                        <exclude>**/CraReminderScheduler*</exclude>
                        <!-- Controllers — tests intégration MockMvc -->
                        <exclude>**/controller/**</exclude>
                        <!-- Modèles / DTOs avec Lombok (setters/getters générés) -->
                        <exclude>**/DashboardSummary*</exclude>
                        <exclude>**/ExpenseItem*</exclude>
                        <exclude>**/ReceiptUploadResponse*</exclude>
                        <exclude>**/ExpenseReportResponse*</exclude>
                        <exclude>**/Notification*</exclude>
                        <exclude>**/IntentResult*</exclude>
                        <exclude>**/ReasoningResult*</exclude>
                        <exclude>**/ConsultantProfile*</exclude>
                        <exclude>**/CraDayEntry*</exclude>
                        <exclude>**/CraRequest*</exclude>
                        <exclude>**/VehicleType*</exclude>
                        <!-- RAG / Rerank — réponses et modèles internes LLM -->
                        <exclude>**/RAGResponse*</exclude>
                        <exclude>**/RAGChunk*</exclude>
                        <exclude>**/ReRank*</exclude>
                        <exclude>**/ReRankService*</exclude>
                        <exclude>**/QueryRewriteService*</exclude>
                        <!-- Organisation / Mission / Ressource — CRUD DB, tests intégration -->
                        <exclude>**/MissionService*</exclude>
                        <exclude>**/ResourceService*</exclude>
                        <exclude>**/OrganizationService*</exclude>
                        <exclude>**/Mission*</exclude>
                        <exclude>**/Resource*</exclude>
                        <exclude>**/Organization*</exclude>
                        <exclude>**/Client*</exclude>
                        <!-- Filtres servlet / Kafka consumers — tests intégration -->
                        <exclude>**/PromptGuardFilter*</exclude>
                        <exclude>**/KafkaNotificationConsumer*</exclude>
                        <exclude>**/TenantFilter*</exclude>
                        <!-- Services fichier / OCR — dépendances système -->
                        <exclude>**/OcrService*</exclude>
                        <exclude>**/ReceiptStorageService*</exclude>
                        <exclude>**/LLMUtils*</exclude>
                        <!-- Modèles request / réponse (records) -->
                        <exclude>**/IntentRequest*</exclude>
                        <exclude>**/SimpleInvoiceRequest*</exclude>
                        <exclude>**/InvoiceClient*</exclude>
                        <!-- Utilitaires techniques -->
                        <exclude>**/TokenCounter*</exclude>
                        <exclude>**/CachedBodyHttpServletRequest*</exclude>
                        <exclude>**/ExpenseIdGenerator*</exclude>
                        <exclude>**/MonthlyLocationScheduler*</exclude>
                        <exclude>**/DuplicateDetectorService*</exclude>
                        <exclude>**/PromptBuilder*</exclude>
                        <!-- Records / DTOs simples non testés unitairement -->
                        <exclude>**/HealthController*</exclude>
                        <exclude>**/CoreAIApplication*</exclude>
                        <exclude>**/InvoiceLookupRequest*</exclude>
                        <exclude>**/DateProvider*</exclude>
                        <exclude>**/ReceiptDuplicateInfo*</exclude>
                        <exclude>**/SellerProfile*</exclude>
                        <exclude>**/DateRange*</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- SpotBugs + FindSecBugs — analyse statique sécurité -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.8.3.1</version>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>1.13.0</version>
                        </plugin>
                    </plugins>
                    <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- OWASP Dependency Check — scan CVE des dépendances -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>9.0.9</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <suppressionFile>owasp-suppressions.xml</suppressionFile>
                    <formats>HTML,JSON</formats>
                </configuration>
                <!-- Exécuté manuellement : mvn dependency-check:check -->
            </plugin>

        </plugins>
    </build>

</project>
