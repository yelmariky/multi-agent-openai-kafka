# Copier ce fichier en .secrets.env et remplir les valeurs
# .secrets.env est dans .gitignore — ne jamais le committer
#
# Usage :
#   cp .secrets.env.example .secrets.env
#   # Remplir les valeurs dans .secrets.env
#   source .secrets.env && ./deploy/secrets/generate-sealed-secrets.sh

# LLM API Keys
export OPENAI_API_KEY="sk-proj-XXXX"
export OPENAI_LLM_API_KEY="gsk_XXXX"          # Groq API key

# PostgreSQL
export POSTGRES_PASSWORD="votre-mot-de-passe-fort"
export POSTGRES_USER="ia_insight"
export POSTGRES_DB="ia_insight"
export POSTGRES_URL="jdbc:postgresql://postgres.db.svc.cluster.local:5432/ia_insight"

# Keycloak admin
export KEYCLOAK_ADMIN_USER="admin"
export KEYCLOAK_ADMIN_PASSWORD="votre-mot-de-passe-fort"

# ai-core internal key
export AI_CORE_ADMIN_KEY="votre-clé-admin-aléatoire"
